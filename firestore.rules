rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────── دوال مساعدة ─────────
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }

    function str(d, k, max) { return k in d && d[k] is string && d[k].size() <= max; }
    function optStr(d, k, max) { return !(k in d) || str(d, k, max); }
    function reqStr(d, k, max) { return str(d, k, max) && d[k].size() >= 1; }
    function optUrl(d, k) { return !(k in d) || (str(d, k, 800) && (d[k] == '' || d[k].matches('^https://.*'))); }
    function optPath(d, k) { return !(k in d) || (str(d, k, 200) && (d[k] == '' || d[k].matches('^[a-z]+/[A-Za-z0-9_.-]+$'))); }
    function optList(d, k, max) { return !(k in d) || (d[k] is list && d[k].size() <= max); }
    function optNum(d, k, lo, hi) { return !(k in d) || (d[k] is number && d[k] >= lo && d[k] <= hi); }
    function flag(d, k) { return k in d && d[k] is bool; }
    function ord(d) { return 'order' in d && d.order is int && d.order >= 0 && d.order < 100000; }
    function optTime(d, k) { return !(k in d) || d[k] is timestamp; }
    function stamps(d) { return optTime(d, 'createdAt') && optTime(d, 'updatedAt'); }

    // ───────── التحقق من كل مجموعة ─────────
    function validDoctor(d) {
      return d.keys().hasOnly(['name','specialty','qualifications','experienceYears','bio','imageUrl','imagePath','order','visible','createdAt','updatedAt'])
        && reqStr(d, 'name', 100) && reqStr(d, 'specialty', 100) && optStr(d, 'qualifications', 200)
        && optNum(d, 'experienceYears', 0, 80) && optStr(d, 'bio', 1500) && optUrl(d, 'imageUrl') && optPath(d, 'imagePath')
        && flag(d, 'visible') && ord(d) && stamps(d);
    }
    function validService(d) {
      return d.keys().hasOnly(['title','description','details','imageUrl','imagePath','order','visible','createdAt','updatedAt'])
        && reqStr(d, 'title', 120) && reqStr(d, 'description', 600) && optStr(d, 'details', 5000)
        && optUrl(d, 'imageUrl') && optPath(d, 'imagePath') && flag(d, 'visible') && ord(d) && stamps(d);
    }
    function validPackage(d) {
      return d.keys().hasOnly(['name','sessions','price','oldPrice','description','features','featured','order','visible','createdAt','updatedAt'])
        && reqStr(d, 'name', 100) && optNum(d, 'sessions', 0, 1000) && 'price' in d && optNum(d, 'price', 0, 10000000)
        && (!('oldPrice' in d) || d.oldPrice == null || (d.oldPrice is number && d.oldPrice >= 0 && d.oldPrice <= 10000000))
        && optStr(d, 'description', 600) && optList(d, 'features', 20) && flag(d, 'featured') && flag(d, 'visible') && ord(d) && stamps(d);
    }
    function validTestimonial(d) {
      return d.keys().hasOnly(['name','rating','comment','imageUrl','imagePath','approved','visible','createdAt','updatedAt'])
        && reqStr(d, 'name', 80) && 'rating' in d && optNum(d, 'rating', 1, 5) && reqStr(d, 'comment', 800)
        && optUrl(d, 'imageUrl') && optPath(d, 'imagePath') && flag(d, 'approved') && flag(d, 'visible') && stamps(d);
    }
    function validGallery(d) {
      return d.keys().hasOnly(['imageUrl','imagePath','caption','category','order','visible','createdAt','updatedAt'])
        && reqStr(d, 'imageUrl', 800) && d.imageUrl.matches('^https://.*') && optPath(d, 'imagePath')
        && reqStr(d, 'caption', 150) && d.category in ['العيادة','الأجهزة','الجلسات','الفريق']
        && flag(d, 'visible') && ord(d) && stamps(d);
    }
    function validFaq(d) {
      return d.keys().hasOnly(['question','answer','order','visible','createdAt','updatedAt'])
        && reqStr(d, 'question', 200) && reqStr(d, 'answer', 2000) && flag(d, 'visible') && ord(d) && stamps(d);
    }
    function validContent(d) {
      return d.keys().hasOnly(['clinicName','logoUrl','logoUrlPath','heroTitle','heroSubtitle','marketingText','heroKicker','heroImageUrl','heroImageUrlPath',
          'heroBadgeTitle','heroBadgeText','heroNote','trustItems','trustCtaLabel','about','aboutCtaLabel','valueItems','vision','mission','features',
          'footerTagline','footerDisclaimer','privacyText','bookingSideNote','phone','whatsapp','email','instagram','facebook','tiktok',
          'workingHours','paymentMethods','address','mapUrl'])
        && optStr(d, 'clinicName', 100) && optUrl(d, 'logoUrl') && optPath(d, 'logoUrlPath')
        && optStr(d, 'heroTitle', 200) && optStr(d, 'heroSubtitle', 600) && optStr(d, 'marketingText', 200) && optStr(d, 'heroKicker', 100)
        && optUrl(d, 'heroImageUrl') && optPath(d, 'heroImageUrlPath') && optStr(d, 'heroBadgeTitle', 100) && optStr(d, 'heroBadgeText', 150) && optStr(d, 'heroNote', 200)
        && optList(d, 'trustItems', 6) && optStr(d, 'trustCtaLabel', 80) && optStr(d, 'about', 3000) && optStr(d, 'aboutCtaLabel', 80)
        && optList(d, 'valueItems', 6) && optStr(d, 'vision', 1500) && optStr(d, 'mission', 1500) && optList(d, 'features', 12)
        && optStr(d, 'footerTagline', 200) && optStr(d, 'footerDisclaimer', 300) && optStr(d, 'privacyText', 8000) && optStr(d, 'bookingSideNote', 100)
        && optStr(d, 'phone', 30) && optStr(d, 'whatsapp', 30) && optStr(d, 'email', 120)
        && optUrl(d, 'instagram') && optUrl(d, 'facebook') && optUrl(d, 'tiktok')
        && optList(d, 'workingHours', 10) && optList(d, 'paymentMethods', 12) && optStr(d, 'address', 300) && optUrl(d, 'mapUrl');
    }
    function validSettings(d) {
      return d.keys().hasOnly(['seoTitle','seoDescription','ogImageUrl','ogImageUrlPath','sections'])
        && optStr(d, 'seoTitle', 120) && optStr(d, 'seoDescription', 320) && optUrl(d, 'ogImageUrl') && optPath(d, 'ogImageUrlPath')
        && (!('sections' in d) || (d.sections is map && d.sections.keys().hasOnly(['about','features','team','services','packages','testimonials','gallery','payments','faq','hours','contact'])));
    }

    // ───────── محتوى الموقع ─────────
    match /site/{docId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && ((docId == 'content' && validContent(request.resource.data)) || (docId == 'settings' && validSettings(request.resource.data)));
      allow delete: if false;
    }

    // ───────── مجموعات تُقرأ للزوار فقط إذا كانت منشورة (visible == true) ─────────
    // مهم: استعلامات الزوار في الكود يجب أن تحتوي where('visible','==',true) وإلا تُرفض.
    match /doctors/{id} {
      allow get, list: if isAdmin() || resource.data.visible == true;
      allow create, update: if isAdmin() && validDoctor(request.resource.data);
      allow delete: if isAdmin();
    }
    match /services/{id} {
      allow get, list: if isAdmin() || resource.data.visible == true;
      allow create, update: if isAdmin() && validService(request.resource.data);
      allow delete: if isAdmin();
    }
    match /packages/{id} {
      allow get, list: if isAdmin() || resource.data.visible == true;
      allow create, update: if isAdmin() && validPackage(request.resource.data);
      allow delete: if isAdmin();
    }
    match /gallery/{id} {
      allow get, list: if isAdmin() || resource.data.visible == true;
      allow create, update: if isAdmin() && validGallery(request.resource.data);
      allow delete: if isAdmin();
    }
    match /faqs/{id} {
      allow get, list: if isAdmin() || resource.data.visible == true;
      allow create, update: if isAdmin() && validFaq(request.resource.data);
      allow delete: if isAdmin();
    }
    // التقييمات: معتمدة + ظاهرة فقط
    match /testimonials/{id} {
      allow get, list: if isAdmin() || (resource.data.approved == true && resource.data.visible == true);
      allow create, update: if isAdmin() && validTestimonial(request.resource.data);
      allow delete: if isAdmin();
    }

    // ───────── الحجوزات ─────────
    function svcDoc(d) { return get(/databases/$(database)/documents/services/$(d.serviceId)).data; }
    function docDoc(d) { return get(/databases/$(database)/documents/doctors/$(d.doctorId)).data; }
    function rateDoc(d) { return getAfter(/databases/$(database)/documents/rateLimits/$(d.phone.replace('\\+', ''))).data; }

    function validBookingCreate(d) {
      return d.keys().hasOnly(['name','phone','serviceId','serviceTitle','doctorId','doctorName','date','time','notes','status','createdAt'])
        && d.keys().hasAll(['name','phone','serviceId','serviceTitle','doctorId','doctorName','date','time','notes','status','createdAt'])
        && str(d, 'name', 80) && d.name.size() >= 2
        && str(d, 'phone', 16) && d.phone.matches('^\\+[1-9][0-9]{7,14}$')
        && str(d, 'serviceId', 40) && d.serviceId.matches('^[A-Za-z0-9]{1,40}$')
        && exists(/databases/$(database)/documents/services/$(d.serviceId))
        && svcDoc(d).visible == true && d.serviceTitle == svcDoc(d).title
        && str(d, 'doctorId', 40) && d.doctorId.matches('^[A-Za-z0-9]{0,40}$')
        && ((d.doctorId == '' && d.doctorName == '')
            || (exists(/databases/$(database)/documents/doctors/$(d.doctorId)) && docDoc(d).visible == true && d.doctorName == docDoc(d).name))
        && str(d, 'date', 10) && d.date.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')
        && d.time in ['', 'صباحاً', 'مساءً']
        && str(d, 'notes', 500)
        && d.status == 'new'
        && d.createdAt == request.time
        && rateDoc(d).at == request.time;
    }

    match /bookings/{id} {
      allow create: if validBookingCreate(request.resource.data);
      allow get, list: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new','pending','confirmed','completed','cancelled'];
      allow delete: if isAdmin();
    }

    // حد الإرسال لكل رقم هاتف: حجز واحد كل 10 دقائق (يُكتب في نفس دفعة الحجز)
    match /rateLimits/{key} {
      allow create: if key.matches('^[1-9][0-9]{7,14}$')
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
      allow update: if key.matches('^[1-9][0-9]{7,14}$')
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time
        && resource.data.at < request.time - duration.value(10, 'm');
      allow get, list, delete: if isAdmin();
    }

    // أي مسار آخر: مرفوض افتراضياً
  }
}
